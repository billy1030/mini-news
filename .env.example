# Database Configuration
# Local Docker PostgreSQL connection string (Postgres on host port 5232)
# Example for Zeabur: postgresql://${POSTGRES_USERNAME}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DATABASE}
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5232/mini_news

# Application / Web Dashboard Port (5200 series)
NODE_ENV=development
PORT=5200

# News Ingestion Poller
POLL_INTERVAL_SECONDS=60
SOURCE_API_URL=https://mutemute.com/mutenews/ajax/app-news.php

# Logging
LOG_LEVEL=info
